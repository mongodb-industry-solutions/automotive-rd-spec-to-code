# MongoDB Atlas & Voyage AI Configuration Template
# Copy this file to .env or export these variables in your shell environment.

# MongoDB Atlas URI (URL-encode special password characters like @ or #)
MONGO_URI="mongodb+srv://<USERNAME>:<PASSWORD>@<CLUSTER>.mongodb.net/?retryWrites=true&w=majority&appName=<APP_NAME>"
MONGO_DB="score_db"
MONGO_COLLECTION="requirements"

# Voyage AI API Key and Embedding Model
VOYAGE_API_KEY="<YOUR_VOYAGE_API_KEY>"
VOYAGE_MODEL="voyage-3.5"

# Atlas Vector Search Index Name
VECTOR_INDEX_NAME="requirements_vector_index"
