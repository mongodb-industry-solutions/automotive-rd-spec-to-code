# Ingestion allowlist
#
# Everything is ignored unless explicitly re-included below. Ingestion should
# enumerate non-ignored files (for example, with `git ls-files --others
# --cached --exclude-standard`) rather than walking the dataset directly.
#
# Keep directories traversable so negated file patterns can match.
*
!*/
!/.gitignore

# ---------------------------------------------------------------------------
# 1. S-CORE process knowledge needed by the SWE.1 -> SWE.4 workflow
# ---------------------------------------------------------------------------

# ASPICE Software Engineering base practices used by the POC.
!/01_eclipse_score/process_description/process/standards/aspice_40/swe/swe.1.rst
!/01_eclipse_score/process_description/process/standards/aspice_40/swe/swe.2.rst
!/01_eclipse_score/process_description/process/standards/aspice_40/swe/swe.3.rst
!/01_eclipse_score/process_description/process/standards/aspice_40/swe/swe.4.rst

# S-CORE guidance and templates for requirements, architecture, implementation,
# and verification. Assets and generated documentation remain ignored.
!/01_eclipse_score/process_description/process/process_areas/requirements_engineering/**/*.rst
!/01_eclipse_score/process_description/process/process_areas/architecture_design/**/*.rst
!/01_eclipse_score/process_description/process/process_areas/architecture_design/**/*.puml
!/01_eclipse_score/process_description/process/process_areas/implementation/**/*.rst
!/01_eclipse_score/process_description/process/process_areas/verification/**/*.rst

# Process graph concepts and definitions.
